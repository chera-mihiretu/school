# Copy to backend/.env. Used by the backend container and the admin seed.
# The app speaks the Postgres protocol. It does not import Neon or Supabase SDKs.

# Local Docker (postgres-service on the compose network — not published on the host)
DATABASE_URL=postgresql://school:school@postgres:5432/school

# Neon (pooled or direct — both work)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Supabase (transaction pooler recommended for the API)
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Optional override if the URL has no sslmode (require | disable)
# DATABASE_SSL=require

# Public URLs: {APP_PROTOCOL}://{label}.{APP_HOST}. Matching strips :{port}.
# HTTP without a port still gets :3000 (local). HTTPS without a port stays unported.
APP_PROTOCOL=http
APP_HOST=e-school.et:3000
LOG_LEVEL=info

# First platform admin (seeded once into platform.admins; ignored if an admin exists)
PLATFORM_ADMIN_EMAIL=cheramihiretu@gmail.com
# 10 letters and numbers. Stored as Argon2id. Used only on the first seed.
PLATFORM_ADMIN_PASSWORD=iLueEHYm5N

# Local default is 36 chars. Production requires 32+.
SESSION_SECRET=dev-only-session-secret-change-me!!
# SESSION_TTL_SECONDS=28800

# SMTP for school-account credentials (Nodemailer). Missing values skip send;
# create still returns 201 with plaintext credentials for the operator reveal.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=e-school.et <accounts@e-school.et>
# SMTP_SECURE=false
